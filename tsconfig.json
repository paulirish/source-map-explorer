{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "module": "ES2015",
    "target": "es2017",
    "diagnostics": true
  },
  "include": ["src"],
  "exclude": ["src/vendor"]
}
